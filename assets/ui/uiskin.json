{
  BitmapFont: {
    default: {
      file: share-tech-mono.fnt
    }
    // Menu font cap height 24 / 3 = 8, matching native Quake glyph height.
    // Keep its natural line spacing and widths; the default UI font is independent.
    menu: {
      file: share-tech-mono-menu.fnt,
      scaledSize: 8,
      useIntegerPositions: false
    }
    font: default
    list: default
    subtitle: default
    window: default
  }
  Color: {
    // Round 1: warm surfaces, cream text, Strawberry actions.
    dark_cocoa: { r: 0.098039, g: 0.078431, b: 0.070588, a: 1 }, // #191412
    chocolate: { r: 0.145098, g: 0.113725, b: 0.098039, a: 1 }, // #251D19
    milk_chocolate: { r: 0.200000, g: 0.152941, b: 0.125490, a: 1 }, // #332720
    cocoa_surface: { r: 0.250980, g: 0.188235, b: 0.152941, a: 1 }, // #403027
    dark_caramel: { r: 0.400000, g: 0.313725, b: 0.247059, a: 1 }, // #66503F
    strawberry: { r: 0.941176, g: 0.470588, b: 0.513725, a: 1 }, // #F07883
    light_strawberry: { r: 1.000000, g: 0.607843, b: 0.639216, a: 1 }, // #FF9BA3
    highlight_raspberry: { r: 0.850980, g: 0.341176, b: 0.411765, a: 1 }, // #D95769
    vanilla_cream: { r: 1.000000, g: 0.952941, b: 0.890196, a: 1 }, // #FFF3E3
    whipped_cream: { r: 0.788235, g: 0.721569, b: 0.647059, a: 1 }, // #C9B8A5
    biscuit: { r: 0.588235, g: 0.517647, b: 0.466667, a: 1 }, // #968477
    muted_cocoa: { r: 0.443137, g: 0.388235, b: 0.352941, a: 1 }, // #71635A
    pistachio: { r: 0.549020, g: 0.796078, b: 0.607843, a: 1 }, // #8CCB9B
    caramel: { r: 0.956863, g: 0.705882, b: 0.372549, a: 1 }, // #F4B45F
    error_raspberry: { r: 0.909804, g: 0.419608, b: 0.447059, a: 1 }, // #E86B72
    blueberry: { r: 0.513725, g: 0.721569, b: 0.898039, a: 1 }, // #83B8E5
    // Semantic roles; legacy palette names remain aliases for compatibility.
    white: vanilla_cream,
    black: dark_cocoa,
    background: dark_cocoa,
    surface: chocolate,
    surfaceOver: milk_chocolate,
    border: biscuit,
    panelBorder: dark_caramel,
    selection: cocoa_surface,
    highlight: light_strawberry,
    warning: caramel,
    error: error_raspberry,
    success: pistachio,
    info: blueberry,
    gray: muted_cocoa,
    disabled: muted_cocoa,
    up: dark_caramel,
    over: light_strawberry,
    down: highlight_raspberry,
    checked: strawberry,
    checkedOver: light_strawberry,
    message: biscuit,
    split: dark_caramel,
    font: vanilla_cream,
    fontSecondary: whipped_cream,
    fontOver: light_strawberry,
    fontDown: vanilla_cream,
    fontChecked: vanilla_cream,
    fontCheckedOver: vanilla_cream,
    fontDisabled: muted_cocoa,
    fontSelected: vanilla_cream,
    lavender_veil: vanilla_cream,
    midnight_violet: dark_cocoa,
    canary_yellow: caramel,
    watermelon: error_raspberry,
    raspberry_plum: strawberry,
    malachite: pistachio,
    strong_cyan: strawberry,
    semiTransparent: { r: 0.2, g: 0.152941, b: 0.12549, a: 0.85 }
  },
  TiledDrawable: {
    progress-bar-knob-t: {
      region: progress-bar-knob
      minWidth: 0
      minHeight: 5
    }
  }
  NinePatchDrawable: {
    // Same 24px corners as the thick frame; half-sized content insets.
    // Like conchars, a thin control can shrink to two corner cells.
    control-panel: {
      patch: panel-thin,
      leftWidth: 12,
      rightWidth: 12,
      topHeight: 12,
      bottomHeight: 12,
      minWidth: 48,
      minHeight: 48
    }
  }
  TintedDrawable: {
    console-panel: {
      name: panel-thick,
      color: { r: 0.400000, g: 0.313725, b: 0.247059, a: 0.8 }
    },
